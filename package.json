{
  "name": "fixit247-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=11.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "wissen": "node scripts/luna-wissen.mjs",
    "test": "vitest run",
    "test:ki": "node --env-file=.env node_modules/vitest/vitest.mjs run src/luna/backend.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test --project=m390 --project=t1024 --project=d1440",
    "shots": "playwright test --project=shots",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "d3-geo": "3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

# Anfrage-Eingang (public/anfrage.php), z. B. /anfrage.php. Für Formular und Luna, wird beim Build eingesetzt.
# Lokal (localhost) gilt immer die Attrappe /api/anfrage aus tools/lokale-api.ts.
VITE_FORM_ENDPOINT=
# KI-Erfassung für Luna (public/chat.php), z. B. /chat.php. Leer = Luna ohne KI. Lokal gilt /api/chat.
VITE_CHAT_ENDPOINT=

# Nur lokal, nie mit VITE_ beginnen (sonst landet der Schlüssel im Browser). Live steht der Schlüssel in
# fixit247-konfig.php außerhalb des Webroots (docs/hosting.md). Genutzt von npm run test:ki und von
# php -S mit tools/php-router.php, wenn die Variablen in der Shell gesetzt sind.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

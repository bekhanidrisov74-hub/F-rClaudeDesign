# Endpunkte für den Live-Build (VITE_FORM_ENDPOINT, VITE_CHAT_ENDPOINT) stehen in .env.production.
# Abweichend nur in .env.production.local setzen. VITE_CHAT_ENDPOINT leer = Luna ohne KI.

# Nur lokal, nie mit VITE_ beginnen (sonst landet der Schlüssel im Browser). Live steht der Schlüssel in
# fixit247-konfig.php außerhalb des Webroots (docs/hosting.md). Genutzt von npm run test:ki und von
# php -S mit tools/php-router.php, wenn die Variablen in der Shell gesetzt sind.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

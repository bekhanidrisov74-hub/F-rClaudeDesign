# Anfrage-Eingang (tools/apps-script.gs als Web-App): URL für Formular und Luna. Wird beim Build eingesetzt.
# Lokal (localhost) gilt immer die Attrappe /api/anfrage aus tools/lokale-api.ts.
VITE_FORM_ENDPOINT=
# KI-Erfassung für Luna (tools/apps-script-chat.gs als Web-App). Leer = Luna ohne KI. Lokal gilt /api/chat.
VITE_CHAT_ENDPOINT=

# Nur lokal, nie mit VITE_ beginnen (sonst landet der Schlüssel im Browser):
# node --env-file=.env tools/server.mjs 8080 leitet /api/chat echt an OpenAI weiter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
